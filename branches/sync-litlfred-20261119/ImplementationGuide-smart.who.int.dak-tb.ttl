       fhir:ImplementationGuide.definition.resource.name [ fhir:value " Receive the client" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "*Business process* (F) Referral:\nActivity:  Receive the client:\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>To know what care the client received at the referral facility \n\nso that\n\n>I can provide appropriate care if my client comes back to my facility" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
