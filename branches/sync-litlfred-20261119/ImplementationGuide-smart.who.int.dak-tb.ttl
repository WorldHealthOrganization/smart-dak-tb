     fhir:ImplementationGuide.definition.resource [
       fhir:index 0 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "Requirements" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.050.F> ;
         fhir:Reference.reference [ fhir:value "Requirements/TB.FXNREQ.050.F" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "  Check whether the client can be accommodated" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "*Business process* (F) Referral:\nActivity:   Check whether the client can be accommodated:\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>To be able the check if the supplies and skills needed to accommodate a referred client are available at my facility\n\nso that\n\n>I can validate to the referring facility (or directly to the client) where the client can be accommodated" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 1 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "Requirements" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.053.G> ;
         fhir:Reference.reference [ fhir:value "Requirements/TB.FXNREQ.053.G" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value " Analyse and interpret the reports" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "*Business process* (G) Aggregate reporting and data use:\nActivity:  Analyse and interpret the reports:\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>To view a range of standardized visualizations (e.g. charts, tables, maps)\n\nso that\n\n>I am able to use data collected at the facility for service delivery and informing programmatic actions with the aim of improving the quality of care for clients with TB" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 2 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "Requirements" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.023.B> ;
         fhir:Reference.reference [ fhir:value "Requirements/TB.FXNREQ.023.B" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value " Assess medical history and risk factors" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "*Business process* (B) Screening:\nActivity:  Assess medical history and risk factors:\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>To be able to capture or update client information related to medical history and risk factors for TB\n\nso that\n\n>I make sure that new relevant information is not missed" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 3 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "Requirements" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.027.C> ;
         fhir:Reference.reference [ fhir:value "Requirements/TB.FXNREQ.027.C" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value " Assess medical history and risk factors" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "*Business process* (C) Diagnosis:\nActivity:  Assess medical history and risk factors:\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>To be able to route the consultation via different health workers and save in the system the information already entered to the consultation even if the consultation is not yet complete, enabling other health workers to see the information already entered and to be able to add or edit information as it becomes available\n\nso that\n\n>I do not have to start a new consultation for every health worker that the client is involved with" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 4 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "Requirements" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.026.C> ;
         fhir:Reference.reference [ fhir:value "Requirements/TB.FXNREQ.026.C" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value " Carry out clinical examination" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "*Business process* (C) Diagnosis:\nActivity:  Carry out clinical examination:\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>The system to use the data entered for a client to generate statistics, graphs, pop-ups (on demand or ad hoc)\n\nso that\n\n>I can take better clinical decisions" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 5 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "Requirements" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.018.A> ;
