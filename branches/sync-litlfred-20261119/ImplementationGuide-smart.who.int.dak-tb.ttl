       fhir:ImplementationGuide.definition.resource.name [ fhir:value "LM.TB.FXNREQ.037.E" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "*Business process* (E) TB preventive treatment (TPT):\nActivity:  Offer TB prevention counselling:\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>To be prompted to provide counselling on TPT\n\nso that\n\n>I can ensure that the client is educated on TPT before offering any TPT-related service" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
