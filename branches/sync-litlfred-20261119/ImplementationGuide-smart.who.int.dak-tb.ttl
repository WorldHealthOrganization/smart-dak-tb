       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://smart.who.int/dak-tb/Binary/LM.TB.FXNREQ.027.C> ;
         fhir:Reference.reference [ fhir:value "Binary/LM.TB.FXNREQ.027.C" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "LM.TB.FXNREQ.027.C" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "*Business process* (C) Diagnosis:\nActivity:  Assess medical history and risk factors:\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>To be able to route the consultation via different health workers and save in the system the information already entered to the consultation even if the consultation is not yet complete, enabling other health workers to see the information already entered and to be able to add or edit information as it becomes available\n\nso that\n\n>I do not have to start a new consultation for every health worker that the client is involved with" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
