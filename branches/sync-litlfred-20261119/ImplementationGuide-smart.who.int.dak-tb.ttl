       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "LM.TB.FXNREQ.028.C" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "*Business process* (C) Diagnosis:\nActivity: C4 Assess history of prior TB treatment:\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>To be able to check client's medical history \n\nso that\n\n>I can use this information for investigations or treatment recommendations" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
