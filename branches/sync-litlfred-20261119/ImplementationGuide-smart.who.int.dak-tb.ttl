       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value " Make an informed decision" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "*Business process* (E) TB preventive treatment (TPT):\nActivity:  Make an informed decision:\nAs a <a href=\"ActorDefinition-healthinformationofficer.html\">Health information officer</a>, I want to:\n>The system to prompt the health worker to get informed consent from the client before proceeding with the TPT evaluation\n\nso that\n\n>I can ensure that client rights are protected" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 28 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "Requirements" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.035.D> ;
         fhir:Reference.reference [ fhir:value "Requirements/TB.FXNREQ.035.D" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value " Manage TB treatment interruptions" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "*Business process* (D) TB Treatment:\nActivity:  Manage TB treatment interruptions:\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>The system to be able to exchange information with digital adherence technologies to automatically record and calculate information related to treatment progress or interruptions\n\nso that\n\n>I do not have to calculate this myself and fill in the information manually" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 29 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "Requirements" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.037.E> ;
         fhir:Reference.reference [ fhir:value "Requirements/TB.FXNREQ.037.E" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value " Offer TB prevention counselling" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "*Business process* (E) TB preventive treatment (TPT):\nActivity:  Offer TB prevention counselling:\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>To be prompted to provide counselling on TPT\n\nso that\n\n>I can ensure that the client is educated on TPT before offering any TPT-related service" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 30 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "Requirements" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.034.D> ;
         fhir:Reference.reference [ fhir:value "Requirements/TB.FXNREQ.034.D" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value " Perform the clinical assessment" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "*Business process* (D) TB Treatment:\nActivity:  Perform the clinical assessment:\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>The system to trigger an alert when a client did not show-up on the intended follow-up day, according to the follow-up schedule\n\nso that\n\n>I could follow up the client in a timely manner to prevent them from being lost to follow-up" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 31 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "Requirements" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.025.B> ;
         fhir:Reference.reference [ fhir:value "Requirements/TB.FXNREQ.025.B" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value " Perform the TB screening" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "*Business process* (B) Screening:\nActivity:  Perform the TB screening:\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>To be able to send referral letters via appropriate digital tools (e.g. email, digital health portal)\n\nso that\n\n>I can speed up the referral process and check-in at the accommodating health-care facility" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 32 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "Requirements" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://smart.who.int/dak-tb/Requirements/TB.FXNREQ.048.F> ;
         fhir:Reference.reference [ fhir:value "Requirements/TB.FXNREQ.048.F" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value " Provide information to the receiving facility" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "*Business process* (F) Referral:\nActivity:  Provide information to the receiving facility:\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>To indicate in the system the referral reason\n\nso that\n\n>I can identify ways to improve the TB care process at my health-care facility" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
