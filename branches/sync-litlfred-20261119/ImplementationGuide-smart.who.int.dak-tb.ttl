       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://smart.who.int/dak-tb/Binary/LM.TB.FXNREQ.031.D> ;
         fhir:Reference.reference [ fhir:value "Binary/LM.TB.FXNREQ.031.D" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "LM.TB.FXNREQ.031.D" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "*Business process* (D) TB Treatment:\nActivity:  Determine the regimen designed to treat rifampicin-resistant TB:\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>To be alerted if a client is allergic to TB-related medications (specify the drugs)\n\nso that\n\n>I immediately know that I cannot prescribe these drugs and client safety is better protected" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
