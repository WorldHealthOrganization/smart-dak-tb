         fhir:Reference.reference [ fhir:value "Requirements/TB.FXNREQ.049.F" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value " Provide information to the receiving facility" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "*Business process* (F) Referral:\nActivity:  Provide information to the receiving facility:\nAs a <a href=\"ActorDefinition-healthworkere.g.nurse.html\">Health worker (e.g. nurse)</a>, I want to:\n>To share the client’s health records with the referral facility \n\nso that\n\n>They can provide the care my client needs" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
